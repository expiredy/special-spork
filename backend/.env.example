# Copy this file to backend/.env and replace every placeholder.
# Never commit backend/.env or share the admin password.

# Admin bootstrap: the backend creates/updates this admin account on startup.
FLOWCOST_ADMIN_USERNAME=admin
FLOWCOST_ADMIN_EMAIL=admin@example.com
FLOWCOST_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Public URL that users open from verification and approval emails.
FLOWCOST_PUBLIC_URL=http://localhost:5173

# SMTP configuration. Example values are provider-specific; use an app password
# where your provider requires it. Keep STARTTLS enabled for port 587.
# Uncomment and fill with real provider values to send actual email.
# FLOWCOST_SMTP_HOST=smtp.your-provider.example
# FLOWCOST_SMTP_PORT=587
# FLOWCOST_SMTP_USERNAME=your-smtp-user
# FLOWCOST_SMTP_PASSWORD=your-smtp-app-password
# FLOWCOST_SMTP_FROM=flowcost@your-domain.example
FLOWCOST_SMTP_STARTTLS=true

# Local development only: when SMTP is not configured, print the verification
# URL to the backend console so you can test the flow. MUST be false in production.
FLOWCOST_DEV_EMAIL_LOG_LINKS=true

# Frontend origins allowed by the API. Add the real deployed frontend origin.
FLOWCOST_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional database override. Relative paths are resolved from backend working dir.
# FLOWCOST_DB_PATH=data/flowcost.sqlite3
